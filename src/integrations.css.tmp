/* ──────────────────────────────────────────
   DevMoter integrations hub
   ────────────────────────────────────────── */

body.integrations-mode {
  padding: 0;
  overflow: hidden;
  background: #0d0f12;
}

.ix-app {
  position: fixed;
  inset: 0;
  height: 100dvh;
  overflow: hidden;
  background:
    radial-gradient(circle at 50% -20%, rgba(105, 126, 255, .12), transparent 42%),
    #0d0f12;
  color: #f3f5f7;
  font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
}

.ix-topbar {
  position: absolute;
  z-index: 10;
  inset: 0 0 auto 0;
  height: calc(62px + env(safe-area-inset-top));
  padding:
    calc(9px + env(safe-area-inset-top))
    max(13px, env(safe-area-inset-right))
    9px
    max(13px, env(safe-area-inset-left));
  display: grid;
  grid-template-columns: 42px 1fr 42px;
  align-items: center;
  gap: 10px;
  border-bottom: 1px solid #252a31;
  background: rgba(13, 15, 18, .9);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
}

.ix-icon {
  width: 42px;
  min-height: 42px;
  padding: 0;
  border: 1px solid #303641;
  border-radius: 12px;
  background: #171b21;
  color: #e9edf2;
}

.ix-title {
  min-width: 0;
  display: grid;
  justify-items: center;
  gap: 1px;
}

.ix-title strong { font-size: .9rem; }
.ix-title small { color: #828b98; font-size: .62rem; }

.ix-main {
  position: absolute;
  inset: calc(62px + env(safe-area-inset-top)) 0 0;
  overflow-y: auto;
  padding:
    22px
    max(14px, env(safe-area-inset-right))
    calc(38px + env(safe-area-inset-bottom))
    max(14px, env(safe-area-inset-left));
}

.ix-hero,
.ix-project-panel,
.ix-cards,
.ix-notice {
  width: min(100%, 720px);
  margin-left: auto;
  margin-right: auto;
}

.ix-hero { margin-bottom: 18px; }
.ix-kicker {
  color: #8794ff;
  font-size: .66rem;
  font-weight: 800;
  letter-spacing: .14em;
}
.ix-hero h1 {
  margin: 7px 0 8px;
  font-size: clamp(1.45rem, 6vw, 2.2rem);
  letter-spacing: -.045em;
}
.ix-hero p {
  margin: 0;
  color: #949daa;
  font-size: .8rem;
  line-height: 1.65;
}

.ix-project-panel {
  margin-bottom: 13px;
  padding: 14px;
  display: grid;
  gap: 8px;
  border: 1px solid #282e37;
  border-radius: 16px;
  background: #14181e;
}
.ix-project-panel label {
  color: #a9b2bf;
  font-size: .7rem;
  font-weight: 700;
}
.ix-project-panel select {
  width: 100%;
  min-height: 44px;
  padding: 0 11px;
  border: 1px solid #343b47;
  border-radius: 11px;
  background: #0e1116;
  color: #f1f3f6;
}
.ix-project-panel small {
  overflow-wrap: anywhere;
  color: #68717e;
  font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
  font-size: .62rem;
}

.ix-cards { display: grid; gap: 12px; }
.ix-card {
  padding: 16px;
  border: 1px solid #2b313b;
  border-radius: 18px;
  background: #15191f;
  box-shadow: 0 14px 34px rgba(0,0,0,.16);
}
.ix-card.disabled { opacity: .57; }
.ix-card-head,
.ix-name-row,
.ix-actions {
  display: flex;
  align-items: center;
}
.ix-card-head { justify-content: space-between; gap: 14px; }
.ix-name-row { gap: 8px; flex-wrap: wrap; }
.ix-name-row h2 {
  margin: 0;
  font-size: 1rem;
  letter-spacing: -.02em;
}
.ix-version {
  display: block;
  max-width: 62vw;
  margin-top: 4px;
  overflow: hidden;
  color: #69727f;
  font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
  font-size: .6rem;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.ix-pill {
  padding: 4px 7px;
  border-radius: 999px;
  background: #272d36;
  color: #9ca5b1;
  font-size: .58rem;
}
.ix-pill.ready { background: #183326; color: #88d9aa; }
.ix-pill.missing { background: #342326; color: #dc9b9b; }

.ix-description {
  margin: 13px 0;
  color: #99a2af;
  font-size: .74rem;
  line-height: 1.62;
}

.ix-actions { gap: 8px; margin-top: 8px; }
.ix-actions button {
  min-width: 0;
  min-height: 42px;
  flex: 1;
  padding: 0 10px;
  border: 1px solid #343b46;
  border-radius: 11px;
  background: #1d222a;
  color: #e9edf2;
  font-size: .72rem;
}
.ix-actions button.primary {
  border-color: #8190ff;
  background: #7f8eff;
  color: #0e1020;
}

.ix-toggle {
  position: relative;
  width: 46px;
  height: 28px;
  flex: 0 0 auto;
}
.ix-toggle input {
  position: absolute;
  opacity: 0;
  pointer-events: none;
}
.ix-toggle span {
  position: absolute;
  inset: 0;
  border: 1px solid #3a414c;
  border-radius: 999px;
  background: #242a32;
}
.ix-toggle span::after {
  content: "";
  position: absolute;
  top: 3px;
  left: 3px;
  width: 20px;
  height: 20px;
  border-radius: 50%;
  background: #9aa3ae;
  transition: transform .16s ease;
}
.ix-toggle input:checked + span {
  border-color: #7383ff;
  background: #5362db;
}
.ix-toggle input:checked + span::after {
  transform: translateX(18px);
  background: #fff;
}

.ix-qr {
  margin-top: 12px;
  padding: 14px;
  display: grid;
  justify-items: center;
  gap: 9px;
  border: 1px solid #2f3540;
  border-radius: 14px;
  background: #fff;
}
.ix-qr.hidden { display: none; }
.ix-qr img {
  width: min(240px, 72vw);
  aspect-ratio: 1;
  object-fit: contain;
}
.ix-qr span {
  color: #333;
  font-size: .68rem;
  font-weight: 700;
}

.ix-notice {
  margin-bottom: 12px;
  padding: 10px 12px;
  border: 1px solid #31553f;
  border-radius: 12px;
  background: #15251b;
  color: #9bd5ad;
  font-size: .72rem;
}
.ix-notice.error {
  border-color: #633a40;
  background: #2a171a;
  color: #e6a0aa;
}
.ix-notice.hidden { display: none; }
.ix-loading {
  padding: 28px 14px;
  color: #77818e;
  text-align: center;
}
.ix-loading.error { color: #d68f99; }
