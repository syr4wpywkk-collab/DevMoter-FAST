{
  "name": "devmoter-fast",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:web": "vite",
    "dev:server": "node server.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "node scripts/lint.mjs",
    "build": "npm run build:office && tsc --noEmit && vite build",
    "start": "node server.mjs",
    "test": "node --test test/*.test.mjs test/**/*.test.mjs",
    "test:coverage": "c8 --reporter=text --reporter=lcov npm test",
    "cli": "node cli/devmoter.mjs",
    "security:audit": "node scripts/security-audit.mjs",
    "build:office": "node scripts/build-office-engine.mjs"
  },
  "devDependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "c8": "^10.1.3",
    "esbuild": "0.25.12",
    "jsdom": "^26.1.0",
    "typescript": "^5.9.2",
    "vite": "^7.1.5"
  },
  "license": "MIT",
  "dependencies": {
    "@simplewebauthn/server": "14.0.2",
    "dompurify": "^3.4.16",
    "fast-xml-parser": "5.11.2",
    "jszip": "3.10.1",
    "marked": "^18.0.14",
    "node-pty": "^1.1.0",
    "oauth4webapi": "3.8.8",
    "utif2": "4.1.0",
    "ws": "^8.21.3"
  },
  "bin": {
    "devmoter": "./cli/devmoter.mjs"
  },
  "exports": {
    "./sdk": "./sdk/index.mjs"
  },
  "overrides": {
    "source-map-js": "^1.2.2"
  }
}
