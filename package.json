{
  "name": "devmoter-fast",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:web": "vite",
    "dev:server": "node server.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "node scripts/lint.mjs",
    "build": "npm run build:office && tsc --noEmit && vite build",
    "start": "node server.mjs",
    "test": "node --test \"test/**/*.test.mjs\"",
    "test:opencode-navigation": "node scripts/test-opencode-navigation.mjs",
    "test:coverage": "c8 --reporter=text --reporter=lcov npm test",
    "cli": "node cli/devmoter.mjs",
    "security:audit": "node scripts/security-audit.mjs",
    "deps:graph": "node scripts/module-graph.mjs",
    "size": "node scripts/bundle-size.mjs",
    "build:office": "node scripts/build-office-engine.mjs",
    "test:workspace-browser": "node --test e2e/*.test.mjs",
    "test:workspace-browser:setup": "playwright install --with-deps webkit"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "c8": "^12.0.0",
    "esbuild": "0.28.2",
    "jsdom": "^31.0.1",
    "playwright": "1.65.1",
    "typescript": "^7.0.2",
    "typescript-legacy": "npm:typescript@5.9.3",
    "vite": "^8.3.8"
  },
  "license": "MIT",
  "dependencies": {
    "@simplewebauthn/server": "14.1.0",
    "dompurify": "^3.4.18",
    "fast-xml-parser": "5.12.1",
    "jszip": "3.10.2",
    "marked": "^18.2.1",
    "node-pty": "^1.1.0",
    "oauth4webapi": "3.8.8",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "utif2": "4.1.0",
    "ws": "^8.23.0"
  },
  "bin": {
    "devmoter": "./cli/devmoter.mjs"
  },
  "exports": {
    "./sdk": "./sdk/index.mjs"
  },
  "overrides": {
    "source-map-js": "^1.2.2",
    "test-exclude": {
      "glob": "^14.0.3",
      "minimatch": "^11.0.4"
    }
  },
  "engines": {
    "node": ">=22"
  }
}
