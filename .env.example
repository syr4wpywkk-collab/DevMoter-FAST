OPENCODE_URL=http://127.0.0.1:49374
OPENCODE_SERVER_USERNAME=opencode
OPENCODE_SERVER_PASSWORD=change-me

POCKET_PORT=8787
POCKET_HOST=127.0.0.1

CODEX_BIN=codex
# CODEX_CWD=/home/user/project


# Required to enable the authenticated project terminal.
# Use a unique value with at least 12 characters.
DEVMOTER_AUTH_PASSWORD=change-this-terminal-password

# Agent-loop detection bounds.
DEVMOTER_LOOP_THRESHOLD=3
DEVMOTER_LOOP_WINDOW=20

# Optional label passed to context-compaction summarizer hooks.
# DEVMOTER_CONTEXT_SUMMARIZER_MODEL=small-summarizer
