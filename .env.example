OPENCODE_URL=http://127.0.0.1:49374
OPENCODE_SERVER_USERNAME=opencode
OPENCODE_SERVER_PASSWORD=change-me

DEVMOTER_AUTH_USERNAME=devmoter
DEVMOTER_AUTH_PASSWORD=replace-with-at-least-16-characters

# Optional first-class owner login. Register a GitHub OAuth App, enable Device Flow,
# and set its public Client ID here. The OAuth access token is never persisted.
# DEVMOTER_GITHUB_CLIENT_ID=Ov23liExamplePublicClientId
# Set this when a reverse proxy changes the externally visible origin.
# DEVMOTER_PUBLIC_ORIGIN=https://your-device.your-tailnet.ts.net

POCKET_PORT=8787
POCKET_HOST=127.0.0.1

CODEX_BIN=codex
# CODEX_CWD=/home/user/project

# Optional model providers (all secrets remain server-side)
# DEVMOTER_OLLAMA_URL=http://127.0.0.1:11434
# DEVMOTER_OLLAMA_MODELS=qwen3-coder
# DEVMOTER_OLLAMA_CAPABILITIES=tools,reasoning,context:32768
# DEVMOTER_OPENAI_COMPAT_BASE_URL=http://127.0.0.1:8000/v1
# DEVMOTER_OPENAI_COMPAT_LABEL=Local OpenAI-compatible
# DEVMOTER_OPENAI_COMPAT_API_KEY=
# DEVMOTER_OPENAI_COMPAT_MODELS=model-a,model-b
# DEVMOTER_OPENAI_COMPAT_CAPABILITIES=tools,vision,reasoning,context:131072

# Inspectable model routing and retry-only failover
# DEVMOTER_MODEL_ROUTES=[{"name":"coding","role":"coding","providerId":"ollama","model":"qwen3-coder"}]
# DEVMOTER_PROVIDER_FAILOVER=openai-compatible/model-a

# Workspace/output grants. Extra directories require explicit canonical grants.
# DEVMOTER_OUTPUT_ROOTS=/home/user/project/dist:/home/user/project/output
# DEVMOTER_ALLOW_EXTERNAL_GRANTS=0

# OS sandbox policy for DevMoter-owned agent tools: off | preferred | required.
# In required mode, external Codex/OpenCode execution is blocked when DevMoter cannot guarantee bwrap mediation.
# DEVMOTER_SANDBOX=preferred

# Optional secondary passkey gate. Basic auth remains the primary HTTP boundary.
# DEVMOTER_PASSKEY_REQUIRED=1
# Temporary recovery/bootstrap only; disable again after registering the intended HTTPS origin.
# DEVMOTER_PASSKEY_BOOTSTRAP=1


# Optional Gemini-style API Chat.
# Provider metadata can be defined here; API keys stay server-side.
# UI-added providers are stored privately in ~/.config/opencode-pocket/llm-providers.json.
# DEVMOTER_LLM_PROVIDERS_JSON=[{"id":"openrouter","name":"OpenRouter","baseUrl":"https://openrouter.ai/api/v1","apiKeyEnv":"OPENROUTER_API_KEY","models":["openai/gpt-5.1-mini"]},{"id":"gemini","name":"Gemini","baseUrl":"https://generativelanguage.googleapis.com/v1beta/openai","apiKeyEnv":"GEMINI_API_KEY","models":["gemini-2.5-flash"]}]
# OPENROUTER_API_KEY=
# GEMINI_API_KEY=
