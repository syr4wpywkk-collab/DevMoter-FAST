{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://devmoter.dev/schemas/deck-plan.json",
  "title": "DeckPlan",
  "description": "A slide-deck plan as emitted by an LLM before rendering to PPTX.",
  "type": "object",
  "required": ["title", "slides"],
  "additionalProperties": false,
  "properties": {
    "title": { "type": "string", "minLength": 1 },
    "audience": { "type": "string" },
    "goal": { "type": "string" },
    "slides": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/planSlide" }
    }
  },
  "definitions": {
    "planSlide": {
      "type": "object",
      "required": ["intent", "heading"],
      "additionalProperties": false,
      "properties": {
        "intent": {
          "type": "string",
          "enum": ["title", "agenda", "concept", "data", "comparison", "summary", "closing"]
        },
        "heading": { "type": "string", "minLength": 1 },
        "bullets": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "table": {
          "type": "object",
          "required": ["header", "rows"],
          "additionalProperties": false,
          "properties": {
            "header": {
              "type": "array",
              "minItems": 1,
              "items": { "type": "string" }
            },
            "rows": {
              "type": "array",
              "items": {
                "type": "array",
                "items": { "type": "string" }
              }
            }
          }
        },
        "chart": {
          "type": "object",
          "required": ["kind", "labels", "series"],
          "additionalProperties": false,
          "properties": {
            "kind": { "type": "string", "enum": ["bar", "line", "pie"] },
            "labels": {
              "type": "array",
              "minItems": 1,
              "items": { "type": "string" }
            },
            "series": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "required": ["name", "values"],
                "additionalProperties": false,
                "properties": {
                  "name": { "type": "string", "minLength": 1 },
                  "values": {
                    "type": "array",
                    "minItems": 1,
                    "items": { "type": "number" }
                  }
                }
              }
            }
          }
        },
        "imageHint": { "type": "string" },
        "notes": { "type": "string" }
      }
    }
  }
}
